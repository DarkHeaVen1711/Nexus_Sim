#pragma once
#ifndef CHARCONV_POLYFILL
#define CHARCONV_POLYFILL
#include <cstring>
#include <system_error>
#include <type_traits>

namespace std {
template <class T>
to_chars_result to_chars(char* first, char* last, T value, int base = 10) {
    static_assert(is_integral<T>::value, "to_chars for non-integral types not polyfilled");
    if (base != 10 && base != 16 && base != 8) return {last, errc::invalid_argument};
    char buf[64];
    int i = 0;
    bool neg = false;
    using U = make_unsigned_t<T>;
    U v;
    if (is_signed<T>::value && value < 0) { neg = true; v = U(-(value + 1)) + 1; }
    else { v = U(value); }
    do { buf[i++] = "0123456789abcdef"[v % base]; v /= base; } while (v);
    if (neg) buf[i++] = '-';
    for (int j = 0; j < i; ++j) {
        if (first + j >= last) return {last, errc::value_too_large};
        first[j] = buf[i - 1 - j];
    }
    return {first + i, errc{}};
}
}
#endif
